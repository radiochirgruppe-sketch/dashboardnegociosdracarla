# ─────────────────────────────────────────────────────────────────
#  Dashboard — Ecossistema Dra. Carla Menini
#  Copie este arquivo para ".env" e preencha com seus dados reais.
#  NUNCA faça commit do arquivo ".env" — ele está no .gitignore.
# ─────────────────────────────────────────────────────────────────

# ── Metricool (plano Advanced obrigatório) ────────────────────────
# Onde obter: Dashboard Metricool → Configurações da conta → API
VITE_METRICOOL_USER_TOKEN=seu_token_aqui
VITE_METRICOOL_USER_ID=seu_user_id_aqui
VITE_METRICOOL_BLOG_ID=seu_blog_id_aqui

# ── Beehiiv (todos os planos, inclusive gratuito) ─────────────────
# Onde obter: Beehiiv → Settings → API → Generate new API key
# Publication IDs: um por newsletter (ver Settings de cada newsletter)
VITE_BEEHIIV_API_KEY=bh_live_xxxxxxxxxxxxxxxxxxxxxx
VITE_BEEHIIV_PUBLICATION_MEDICINA=pub_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_BEEHIIV_PUBLICATION_DESAFIOS=pub_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Shopee Afiliados Brasil (requer aprovação como parceiro) ──────
# Onde obter: affiliate.shopee.com.br → sua conta → API/Developer
# Cada request usa SHA-256: SHA256(AppId + Timestamp + Payload + Secret)
VITE_SHOPEE_APP_ID=seu_app_id_aqui
VITE_SHOPEE_SECRET_KEY=sua_secret_key_aqui

# ── Meta Ads API (Meta Marketing API v22.0) ───────────────────────
# Onde obter: developers.facebook.com → seu App → System User Token
# Recomendado: System User Token (não expira) via Business Manager
# Business Manager → Configurações → Usuários do sistema → Gerar token
VITE_META_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_META_AD_ACCOUNT_ID=act_000000000000000

# ── YouTube Data API v3 (gratuito) ───────────────────────────────
# Canal já configurado: UCdIaqlE_pylO1JK4hJC9KGQ
# Onde obter: console.cloud.google.com → APIs → YouTube Data API v3
#   → Credenciais → Criar chave de API (restrinja ao domínio do dashboard)
VITE_YOUTUBE_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Analytics 4 (GA4 Data API) ────────────────────────────
# Onde obter: console.cloud.google.com → Ativar "Google Analytics Data API"
#   → IAM → Criar conta de serviço → baixar JSON → adicionar e-mail
#   da conta de serviço como Visualizador na propriedade GA4
VITE_GA4_PROPERTY_ID=properties/000000000
# Cole o conteúdo do JSON da conta de serviço em uma linha (stringify)
VITE_GA4_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
